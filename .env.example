# DND AI - Environment Configuration (OPTIMIZED VERSION)

# ===== Python AI Server (FastAPI) =====
PYTHON_SERVER_HOST=0.0.0.0
PYTHON_SERVER_PORT=8000

# ===== Express/TypeScript Server =====
EXPRESS_PORT=3000
EXPRESS_HOST=0.0.0.0

# ===== Frontend connection to Python server =====
# Если Python сервер стартует на другом порту, укажи его здесь:
# VITE_PYTHON_SERVER=http://localhost:8001

# ===== Inter-server Communication =====
# TypeScript uses this to call Python server
VITE_PYTHON_SERVER=http://localhost:8000

# ===== Performance Limits =====
# All requests must complete within this timeout
TIMEOUT_MS=12000

# Max tokens per agent (reduced for speed)
MAX_TOKENS_ORCHESTRATOR=40
MAX_TOKENS_JUDGE=80
MAX_TOKENS_KEEPER=50
MAX_TOKENS_STORYTELLER=120

# ===== Inference Settings =====
USE_QUANTIZATION=true
USE_GREEDY_DECODING=true
TEMPERATURE_JUDGE=1.0
TEMPERATURE_STORYTELLER=0.7

# ===== Logging =====
LOG_LEVEL=info
DEBUG=false

# ===== (DEPRECATED - kept for compatibility) =====
# No longer using Google Gemini API - using local models instead
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"

