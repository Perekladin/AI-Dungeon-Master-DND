# D&D Core AI — переменные окружения
# Этот файл — пример. Реальные значения (если нужны) копируй в .env.
# В большинстве случаев СЕРВЕР РАБОТАЕТ БЕЗ .env — все нужные значения уже
# заданы дефолтами в коде. Этот файл — только если хочешь что-то поменять.

# ====================================================================
# Python-сервер (FastAPI + transformers + Ollama-клиент)
# ====================================================================

# IP-интерфейс на котором слушает Python-сервер.
# По умолчанию 0.0.0.0 — слушает все интерфейсы (LAN + localhost + Tailscale).
# Меняй только если хочешь привязать ТОЛЬКО к localhost.
# PYTHON_SERVER_HOST=0.0.0.0

# Порт Python-сервера. Если занят — автоматически берёт следующий свободный.
# PYTHON_SERVER_PORT=8000

# Максимум моделей в VRAM одновременно (LRU-кэш).
# Авто-подбирается: CUDA с квантованием = 5, DirectML (AMD) = 1.
# Раскомментируй чтобы переопределить вручную.
# MODEL_CACHE_MAX=1

# ====================================================================
# Ollama (Narrative-агент)
# ====================================================================

# URL Ollama-сервера. По умолчанию локальный.
# OLLAMA_HOST=http://localhost:11434

# Имя модели для Narrative-агента в Ollama. Скачивается через `ollama pull`.
# NARRATIVE_MODEL=qwen2.5:7b-instruct-q4_K_M

# ====================================================================
# Frontend (Vite/React)
# ====================================================================

# Адрес Python-сервера для фронта.
# По умолчанию фронт берёт хост из window.location и подставляет порт 8000.
# Раскомментируй если нужно жёстко задать (например через reverse-proxy).
# VITE_PYTHON_SERVER=http://localhost:8000
